{
  "expo": {
    "name": "ProdTrack",
    "slug": "prodtrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prodtrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.prodtrack.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "ProdTrack utilise Face ID pour déverrouiller l'application."
      }
    },
    "android": {
      "package": "com.prodtrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#A86B2D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "ProdTrack",
      "shortName": "ProdTrack",
      "lang": "fr",
      "themeColor": "#A86B2D",
      "backgroundColor": "#FFFFFF",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A86B2D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "ProdTrack utilise l'appareil photo pour photographier vos produits.",
          "photosPermission": "ProdTrack accède à vos photos pour illustrer vos produits et votre profil."
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ProdTrack utilise Face ID pour déverrouiller l'application."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A86B2D"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
